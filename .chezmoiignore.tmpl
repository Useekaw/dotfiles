# ignore on all systems
README.md
LICENSE
bootstrap.sh
install*.sh
styles
.vimrc
.lazy-lock.json
**/*.backup*
**/*.dmsbackup*

# autogenerated theme files
.config/alacritty/dank-theme.toml
.config/gtk-3.0/dank-colors.css
.config/gtk-4.0/dank-colors.css

# vendored yazi plugin code, deployed via `ya pkg install` from package.toml
.config/yazi/plugins

# ignore desktop specific configs on servers and inside WSL (no GUI/display server there)
{{- if not .is_desktop }}
.config/alacritty
.config/DankMaterialShell
.config/gtk-3.0
.config/gtk-4.0
.config/matugen
.config/Code - OSS
{{- end }}

# yazi theme is generated locally by matugen (non-work desktop only), so only
# manage a static theme.toml via chezmoi on the work machine
{{- if not .is_work }}
.config/yazi/theme.toml
{{- end }}

# VS Code (OSS) config is not needed on the work machine
{{- if .is_work }}
.config/Code - OSS
{{- end }}

# wslview shim is only needed inside WSL (opens links via the Windows browser)
{{- if not .is_wsl }}
.local/bin/wslview
{{- end }}

# Hoth SPICE launcher (personal Proxmox VM) is only relevant on personal machines
{{- if .is_work }}
.local/bin/hoth_spice.sh
.local/share/applications/hoth-rdp.desktop
{{- end }}

# Ignore generated (more or less) files in the .ssh directory
.ssh/authorized_keys
.ssh/known_hosts

