#!/usr/bin/env bash
# unit hash: {{ include "dot_config/systemd/user/chezmoi-update-check.service" | sha256sum }}-{{ include "dot_config/systemd/user/chezmoi-update-check.timer" | sha256sum }}

set -euo pipefail

if command -v systemctl >/dev/null 2>&1 && systemctl --user status >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable --now chezmoi-update-check.timer
else
  echo "systemd --user not available; skipping chezmoi-update-check.timer setup." >&2
fi
