#!/usr/bin/env bash
set -euo pipefail

if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

status_file="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-update-status"
source_dir="$(chezmoi source-path)"

cd "$source_dir"
git fetch --quiet

local_rev=$(git rev-parse @)
remote_rev=$(git rev-parse '@{u}')

if [ "$local_rev" != "$remote_rev" ]; then
  git pull --ff-only --quiet
fi

# Always check for diff, not just after a pull: destination state can drift
# from an already-in-sync source too (manual edits never `chezmoi add`ed).
diff_output=$(chezmoi diff || true)

mkdir -p "$(dirname "$status_file")"
if [ -n "$diff_output" ]; then
  echo "↻ chezmoi: Diff vorhanden (chezmoi diff/apply prüfen)" > "$status_file"
else
  rm -f "$status_file"
fi
