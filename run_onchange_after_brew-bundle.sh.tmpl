#!/usr/bin/env bash
# Runs brew bundle whenever Brewfile changes.
# Brewfile hash: {{ include "dot_brewfile.tmpl" | sha256sum }}

set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "brew not found; skipping brew bundle." >&2
  exit 0
fi

# Homebrew refuses to load formulae from non-official taps until they are
# trusted; trust only the single formulae the Brewfile pulls from them
brew trust --formula smarzban/tap/tsk
{{- if not .is_work }}
brew trust --formula hougesen/tap/kdlfmt
{{- end }}

brew bundle --file="${HOME}/.brewfile" --verbose
