# Set the theme
# matugen.tmtheme is only generated by matugen on non-work desktops; everywhere
# else (work, servers, WSL) fall back to bat's built-in gruvbox-dark
{{- if and .is_desktop (not .is_work) }}
--theme="matugen"
{{- else }}
--theme="gruvbox-dark"
{{- end }}

# Use plain style
--style="plain"