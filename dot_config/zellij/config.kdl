//
// Minimal config: relies on zellij's built-in default keybinds, only the
// handful of real customizations below. No `clear-defaults=true` dump —
// that duplicated the stock keymap and drifts out of sync with new zellij
// releases.
//

// Base mode is "locked" instead of the zellij default "normal". In normal
// mode zellij intercepts Ctrl+p/n/h/t/s/o/g/q globally to switch modes,
// which steals shell readline shortcuts (Ctrl+p/n = history, Ctrl+h =
// backspace on some terminals) and TUI apps' own bindings (Claude Code
// included) before they ever reach the pane. In locked mode every
// keystroke passes straight through to the running program.
//
// Ctrl+g: locked -> normal (manage panes/tabs/sessions)
// Ctrl+g again (or after an action): back to locked
default_mode "locked"

// Plugin aliases - can be used to change the implementation of Zellij
// changing these requires a restart to take effect
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

// Plugins to load in the background when a new session starts
load_plugins {
    zellij:link
}

ui {
    pane_frames {
        rounded_corners true
    }
}

web_client {
    font "monospace"
}

// Choose the theme that is specified in the themes section.
theme "gruvbox-dark"

// Set the pane frame style when pane_frames is enabled
pane_frame_style "full"

// A fixed name to always give the Zellij session, combined with
// attach_to_session: `zellij` with no args always lands you back in the
// same session - exactly what you want when reconnecting over SSH from a
// phone.
session_name "default"
attach_to_session true

// Whether to show tips on startup
show_startup_tips false
