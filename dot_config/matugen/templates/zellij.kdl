// UI chrome (text/ribbon/table/list/frame/exit_code) uses matugen's own
// Material-You roles - fine here, these are single accent colors, same
// pattern as the yazi template. terminal_colors / multiplayer_user_colors
// are deliberately NOT rendered here: an earlier attempt approximated them
// from primary/secondary/tertiary/error, which produced washed-out,
// barely-distinguishable ANSI colors once Claude Code's dark-ansi theme
// actually used them as `ansi:<name>` selection/diff backgrounds. A
// matugen post_hook (~/.local/bin/zellij-ansi-sync.py, wired up in
// ~/.config/matugen/config.toml) splices in DMS's real dank16 palette
// instead - same colors alacritty already renders correctly.

themes {
    matugen {
        text_unselected {
            base {{colors.on_surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background {{colors.surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_0 {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        text_selected {
            base {{colors.on_surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background {{colors.surface_variant.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_0 {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        ribbon_selected {
            base {{colors.on_primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_0 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.on_primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        ribbon_unselected {
            base {{colors.on_surface_variant.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background {{colors.surface_variant.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_0 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.on_surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        table_title {
            base {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background 0
            emphasis_0 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.on_surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        table_cell_selected {
            base {{colors.on_surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background {{colors.surface_variant.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_0 {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        table_cell_unselected {
            base {{colors.on_surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background {{colors.surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_0 {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        list_selected {
            base {{colors.on_surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background {{colors.surface_variant.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_0 {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        list_unselected {
            base {{colors.on_surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background {{colors.surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_0 {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        frame_selected {
            base {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background 0
            emphasis_0 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 0
        }
        frame_highlight {
            base {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background 0
            emphasis_0 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        exit_code_success {
            base {{colors.tertiary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background 0
            emphasis_0 {{colors.secondary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 {{colors.surface.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_2 {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_3 {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
        }
        exit_code_error {
            base {{colors.error.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            background 0
            emphasis_0 {{colors.primary.default.hex | format: "rgb" | replace: "rgb(", "" | replace: ")", "" | replace: ",", ""}}
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
    }
}
