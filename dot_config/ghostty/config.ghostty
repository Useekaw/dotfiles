# Mirrors ~/.config/alacritty/alacritty.toml as closely as Ghostty allows.

# Colors are generated by DankMaterialShell (matugen) into themes/dankcolors.
# Loaded as an optional include instead of `theme = dankcolors`, because a
# missing theme is a config error and the file does not exist on machines
# without DMS.
config-file = ?themes/dankcolors

font-family = JetBrainsMono Nerd Font
# alacritty's default size; Ghostty would default to 12
font-size = 11.25

window-decoration = none
window-padding-x = 12
window-padding-y = 12

cursor-style = block
cursor-style-blink = true
# shell integration would otherwise switch the cursor to a bar at the prompt
shell-integration-features = no-cursor

mouse-hide-while-typing = true
# alacritty: selection.save_to_clipboard = true
copy-on-select = clipboard

# alacritty closes without asking
confirm-close-surface = false

# Same sequence alacritty sends, so Shift+Enter keeps working in apps that do
# not enable the kitty keyboard protocol.
keybind = shift+enter=csi:13;2u
