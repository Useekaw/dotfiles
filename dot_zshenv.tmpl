# This file is sourced by all instances

export EDITOR=nvim

# PATH
export PATH="${HOME}/.local/bin:${PATH}"

# Activate ssh-agent
eval "$(ssh-agent -s)" > /dev/null 2>&1
ssh-add "${HOME}/.ssh/id_ed25519" > /dev/null 2>&1

# some dir defaults. see https://specifications.freedesktop.org/basedir-spec/latest/
[[ -z "${XDG_DATA_HOME}" ]] && export XDG_DATA_HOME="${HOME}/.local/share"
[[ -z "${XDG_CONFIG_HOME}" ]] && export XDG_CONFIG_HOME="${HOME}/.config"
[[ -z "${XDG_STATE_HOME}" ]] && export XDG_STATE_HOME="${HOME}/.local/state"
[[ -z "${XDG_CACHE_HOME}" ]] && export XDG_CACHE_HOME="${HOME}/.cache"
[[ -z "${XDG_DATA_DIRS}" ]] && export XDG_DATA_DIRS="/usr/local/share:/usr/share"
[[ -z "${XDG_CONFIG_DIRS}" ]] && export XDG_CONFIG_DIRS="/etc/xdg"

# fixes issue with brew and node (unable to find certificates )
# this way node can always use the ones provided by the system
export NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
{{- if .is_wsl }}

# open links via Windows default browser (needed e.g. for MCP/OAuth flows in WSL)
export BROWSER=wslview
{{- end }}
{{- if not .is_work }}

# route Claude Code through OpenRouter (personal machine only)
export OPENROUTER_API_KEY="{{ (include ".secrets/openrouter_api_key.age") | decrypt }}"
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
export ANTHROPIC_API_KEY=""
{{- end }}
